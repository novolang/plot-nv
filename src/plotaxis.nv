// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.with_range(plotaxis.linear("x"), 0.0, 100.0).max}")
// ```
pub fn with_range(a: PlotAxis, min: Float, max: Float) -> PlotAxis
    todo("plot-nv.plotaxis.with_range")

// The same axis with a different tick rule.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.with_ticks(plotaxis.linear("x"), PlotTicksCount(4)).label)
// ```
pub fn with_ticks(a: PlotAxis, rule: PlotTickRule) -> PlotAxis
    todo("plot-nv.plotaxis.with_ticks")

// The same axis with a different number format.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.with_format(plotaxis.linear("x"), PlotFormatFixed(1)).label)
// ```
pub fn with_format(a: PlotAxis, f: PlotNumberFormat) -> PlotAxis
    todo("plot-nv.plotaxis.with_format")

// The same axis with the grid on or off.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.with_grid(plotaxis.linear("x"), true).grid}")
// ```
pub fn with_grid(a: PlotAxis, grid: Bool) -> PlotAxis
    todo("plot-nv.plotaxis.with_grid")

// Whether the axis takes its range from the data rather than being told
// it.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.is_auto_range(plotaxis.linear("x"))}")
// ```
pub fn is_auto_range(a: PlotAxis) -> Bool
    todo("plot-nv.plotaxis.is_auto_range")

// A range that covers the data and ends on round numbers.
//
// What an automatic axis resolves to: the data's own extent, widened to
// the nearest tick under the axis's rule, so the outermost points are
// not on the frame.  A data range with no extent at all — one point, or
// many identical ones — is given a unit width around the value, because
// an axis from 5 to 5 has no positions in it.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.padded_range(plotaxis.linear("x"), 0.3, 9.7).max}")
// ```
pub fn padded_range(a: PlotAxis, data_min: Float, data_max: Float) -> PlotAxis
    todo("plot-nv.plotaxis.padded_range")

// The ticks a scale and a rule put on a range.
//
// The whole of the tick algorithm, as one function over four values —
// so a caller can test the placement without building a figure, and so
// two backends cannot place them differently.
//
// ```novo
// use plotaxis
// use std.list
//
// fn main() [io]
//     println("${list.len(plotaxis.ticks_for(PlotLinear, PlotTicksNice(6), 0.0, 10.0))}")
// ```
pub fn ticks_for(scale: PlotScale, rule: PlotTickRule, min: Float, max: Float) -> [PlotTick]
    todo("plot-nv.plotaxis.ticks_for")

// The ticks an axis puts on its own range, labelled by its own format.
//
// `ticks_for` plus the labelling, which is the call a renderer makes.
// An axis whose range is still automatic answers an empty list: there is
// no range to place ticks on until `padded_range` has resolved it.
//
// ```novo
// use plotaxis
// use std.list
//
// fn main() [io]
//     let a = plotaxis.with_range(plotaxis.linear("x"), 0.0, 10.0)
//     println("${list.len(plotaxis.ticks_of(a))}")
// ```
pub fn ticks_of(a: PlotAxis) -> [PlotTick]
    todo("plot-nv.plotaxis.ticks_of")

// A tick from its parts.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.tick(1.0, "1", true).label)
// ```
pub fn tick(value: Float, label: Str, major: Bool) -> PlotTick
    todo("plot-nv.plotaxis.tick")

// Where a data value sits along the axis, as a fraction: 0.0 at `min`
// and 1.0 at `max`.
//
// THE ONE FUNCTION EVERY BACKEND SHARES.  A fraction rather than a
// coordinate, because the fraction does not know how big the drawing is
// — which is what lets the same figure render at 640 pixels and at 1920
// with every point in the same relative place.  Values outside the range
// give fractions outside `0.0 ..= 1.0`; clipping is the renderer's job.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.position(PlotLinear, 5.0, 0.0, 10.0)}")
// ```
pub fn position(scale: PlotScale, value: Float, min: Float, max: Float) -> Float
    todo("plot-nv.plotaxis.position")

// The data value at a fraction along the axis.  The inverse of
// `position`.
//
// What a notebook's hover readout needs: a pixel came in, a data value
// has to come out.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.value_at(PlotLinear, 0.5, 0.0, 10.0)}")
// ```
pub fn value_at(scale: PlotScale, fraction: Float, min: Float, max: Float) -> Float
    todo("plot-nv.plotaxis.value_at")

// Whether a scale can represent this range at all.
//
// False exactly when a logarithmic scale's range includes zero.  Asked
// before rendering, so the fault names the axis rather than appearing as
// a point at infinity.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.range_is_valid(PlotLog(10.0), 0.0, 100.0)}")
// ```
pub fn range_is_valid(scale: PlotScale, min: Float, max: Float) -> Bool
    todo("plot-nv.plotaxis.range_is_valid")

// A number written in a format.
//
// Public because a legend entry, a title and a hover readout all have to
// spell a number the same way the ticks do.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.format_value(PlotFormatFixed(2), 3.14159))
// ```
pub fn format_value(f: PlotNumberFormat, value: Float) -> Str
    todo("plot-nv.plotaxis.format_value")

// The format `PlotFormatAuto` resolves to for a given tick set.
//
// Chosen from the whole SET rather than per value, which is why it takes
// a list: an axis that wrote `1`, `1.5`, `2` would be right about each
// number and wrong as an axis, and one that wrote `1.0`, `1.5`, `2.0` is
// what a reader expects.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.format_value(plotaxis.auto_format([0.0, 0.5, 1.0]), 0.5))
// ```
pub fn auto_format(values: [Float]) -> PlotNumberFormat
    todo("plot-nv.plotaxis.auto_format")

// Heckbert's nice number at or above `v`, as `1`, `2`, `5` or `10` times
// a power of ten.
//
// The primitive the default rule is built from, public because it is the
// thing to test: an implementation that gets this right gets every
// linear axis right, and one that gets it wrong is visibly wrong at
// every scale.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println("${plotaxis.nice_number(3.7, true)}")
// ```
pub fn nice_number(v: Float, round_up: Bool) -> Float
    todo("plot-nv.plotaxis.nice_number")
