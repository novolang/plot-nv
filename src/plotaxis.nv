pub fn log10(label: Str) -> PlotAxis
    todo("plot-nv.plotaxis.log10")

// A categorical axis: one tick per label, at 0, 1, 2 and so on.
//
// What a bar chart's label axis is.  The scale is linear and the ticks
// are `PlotTicksAt` on the integers, which means a caller can mix bars
// and a line on the same axes without a second coordinate system.
//
// ```novo
// use plotaxis
//
// fn main() [io]
//     println(plotaxis.categorical("region", ["north", "south"]).label)
// ```
pub fn categorical(label: Str, categories: [Str]) -> PlotAxis
    todo("plot-nv.plotaxis.categorical")

// The same axis with a fixed range instead of an automatic one.
