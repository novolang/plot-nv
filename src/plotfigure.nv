// ```
pub fn add_axes(f: PlotFigure, ax: PlotAxes) -> PlotFigure
    todo("plot-nv.plotfigure.add_axes")

// The same axes with one more series on it.
//
// ```novo
// use plotfigure
// use plotaxis
// use plotseries
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     let s = plotseries.line("y", [0.0], [0.0])
//     println("${list.len(plotfigure.add_series(ax, s).series)}")
// ```
pub fn add_series(ax: PlotAxes, s: PlotSeries) -> PlotAxes
    todo("plot-nv.plotfigure.add_series")

// The same axes placed at a fractional rectangle of the figure.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${plotfigure.placed_at(ax, 0.0, 0.0, 0.5, 1.0).fw}")
// ```
pub fn placed_at(ax: PlotAxes, fx: Float, fy: Float, fw: Float, fh: Float) -> PlotAxes
    todo("plot-nv.plotfigure.placed_at")

// The same axes with a title.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println(plotfigure.with_axes_title(ax, "north").title)
// ```
pub fn with_axes_title(ax: PlotAxes, title: Str) -> PlotAxes
    todo("plot-nv.plotfigure.with_axes_title")

// The same axes with a legend somewhere, or none.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${plotfigure.with_legend(ax, plotfigure.legend_at(PlotLegendRight)).legend.visible}")
// ```
pub fn with_legend(ax: PlotAxes, legend: PlotLegend) -> PlotAxes
    todo("plot-nv.plotfigure.with_legend")

// The same axes with different gutters, as fractions of its own box.
//
// The manual half of "no layout engine": a caller who measured its tick
// labels with a font package sets the gutters from what it measured.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${plotfigure.with_gutters(ax, 0.2, 0.15, 0.08, 0.03).gutter_left}")
// ```
pub fn with_gutters(ax: PlotAxes, left: Float, bottom: Float, top: Float, right: Float) -> PlotAxes
    todo("plot-nv.plotfigure.with_gutters")

// A legend at a position, visible.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${plotfigure.legend_at(PlotLegendTopLeft).visible}")
// ```
pub fn legend_at(position: PlotLegendPos) -> PlotLegend
    todo("plot-nv.plotfigure.legend_at")

// A legend that is not drawn.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${plotfigure.no_legend().visible}")
// ```
pub fn no_legend() -> PlotLegend
    todo("plot-nv.plotfigure.no_legend")

// The rectangle an axes' whole box occupies, in figure coordinates.
//
// ```novo
// use plotfigure
// use plotaxis
// use geomrect
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${geomrect.width(plotfigure.box_of(ax, 640.0, 480.0))}")
// ```
pub fn box_of(ax: PlotAxes, fig_width: Float, fig_height: Float) -> GeomRectF
    todo("plot-nv.plotfigure.box_of")

// The rectangle the DATA is drawn in: the box less its gutters, and less
// the strip a `PlotLegendRight` takes.
//
// The one every coordinate in a rendered chart is relative to, which is
// why it is public: a caller doing its own hit-testing maps a pointer
// position back through this rectangle and `plotaxis.value_at`.
//
// ```novo
// use plotfigure
// use plotaxis
// use geomrect
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${geomrect.width(plotfigure.plot_area_of(ax, 640.0, 480.0))}")
// ```
pub fn plot_area_of(ax: PlotAxes, fig_width: Float, fig_height: Float) -> GeomRectF
    todo("plot-nv.plotfigure.plot_area_of")

// The transform from data coordinates to figure coordinates for this
// axes, with the y axis flipped.
//
// geometry-nv's `mapping` applied to the plot area, and the reason this
// package does not carry a projection of its own: a data point becomes a
// figure point by `geomxform.apply_point`, and the flip — data y grows
// up, drawing y grows down — falls out of asking for a destination
// rectangle whose height is negative.
//
// Only defined for axes whose ranges are resolved; one still on
// automatic gives the identity.
//
// ```novo
// use plotfigure
// use plotaxis
// use geomxform
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${geomxform.is_identity(plotfigure.data_to_figure(ax, 640.0, 480.0))}")
// ```
pub fn data_to_figure(ax: PlotAxes, fig_width: Float, fig_height: Float) -> GeomXform
    todo("plot-nv.plotfigure.data_to_figure")

// The same axes with both ranges resolved from the series on it.
//
// What an automatic axis becomes: every series' extent unioned, padded
// to the next tick.  Called by the renderer, and public because a caller
// that wants to know what range its chart will end up with should be
// able to ask without rendering.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${plotfigure.resolved(ax).x.max}")
// ```
pub fn resolved(ax: PlotAxes) -> PlotAxes
    todo("plot-nv.plotfigure.resolved")

// Whether every series on every axes has consistent data and every
// scale can hold its range.
//
// The check `plotdraw.render` makes first.  Asking it separately lets a
// notebook cell report a bad figure without producing an empty chart.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     match plotfigure.validate(plotfigure.figure(10.0, 10.0, []))
//         Ok(_)  => println("ok")
//         Err(_) => println("refused")
// ```
pub fn validate(f: PlotFigure) -> Result<PlotFigure, PlotFault>
    todo("plot-nv.plotfigure.validate")
