// plotfigure.nv — the whole picture: a canvas, and the axes on it.
//
// AN AXES IS PLACED BY FRACTIONS, not by a rectangle.  `PlotAxes` says
// where it sits as four numbers in `0.0 ..= 1.0` of the figure, so a
// figure is resolution-independent: the same value renders at 640
// pixels and at 1920 with every axes in the same relative place, and
// `plotraster`'s scale factor is a multiplication rather than a
// re-layout.  It is matplotlib's `add_axes` rectangle, and it is also
// the answer to a constraint — a boxed struct cannot hold a `@value`
// `GeomRectF` field (SPEC §14.5), so the alternative was four Floats
// either way and fractions are the four that carry more.
//
// NO LAYOUT ENGINE, and that is a decision rather than an omission.
// matplotlib's `tight_layout` measures every tick label and title and
// solves for margins that fit them — which needs text metrics, which
// need a font file, which needs a filesystem.  This package is `core`
// and has none.  So `grid` computes the fractions for a regular grid of
// subplots and the gutters are a fixed fraction the caller can change;
// a caller who wants labels measured measures them with a font package
// and sets the fractions itself.
//
// NO EFFECTS.

use srgb
use plotaxis
use plotseries

// Where a legend sits.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${PlotLegendTopRight == PlotLegendTopRight}")
// ```
pub enum PlotLegendPos
    // Inside the plot area, top right.  The default, and the corner
    // most charts leave empty.
    PlotLegendTopRight
    // Inside, top left.
    PlotLegendTopLeft
    // Inside, bottom right.
    PlotLegendBottomRight
    // Inside, bottom left.
    PlotLegendBottomLeft
    // In a strip to the right of the plot area, which the plot area is
    // narrowed to make room for.  What a chart with many series needs,
    // and the only position that takes space from the data.
    PlotLegendRight

// Whether and where a legend is drawn.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${plotfigure.legend_at(PlotLegendTopRight).visible}")
// ```
pub struct PlotLegend
    // Whether it is drawn at all.  A legend with no named series is not
    // drawn whatever this says — an empty box in the corner of a chart
    // is worse than no box.
    visible: Bool
    // Where it sits.
    position: PlotLegendPos

// One set of axes: two scales, the series on them, and where it sits.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
//     println("${ax.fw}")
// ```
pub struct PlotAxes
    // The horizontal axis.
    x: PlotAxis
    // The vertical axis.
    y: PlotAxis
    // What is drawn on them, in order — so a later series draws over an
    // earlier one, which is how a caller puts a fitted line on top of
    // its scatter.
    series: [PlotSeries]
    // A heading above this axes.  Empty draws none.
    title: Str
    // Whether and where the legend goes.
    legend: PlotLegend
    // The left edge of this axes' box, as a fraction of the figure's
    // width.  The BOX includes the gutters the labels are drawn in, not
    // just the plot area — `plot_area_of` is what takes the gutters off.
    fx: Float
    // The top edge, as a fraction of the figure's height.
    fy: Float
    // How wide the box is, as a fraction.
    fw: Float
    // How tall it is, as a fraction.
    fh: Float
    // How much of the box's width the left gutter takes, for tick
    // labels and the y axis label.
    gutter_left: Float
    // How much of the box's height the bottom gutter takes.
    gutter_bottom: Float
    // How much of the box's height the top gutter takes, for the title.
    gutter_top: Float
    // How much of the box's width the right gutter takes.
    gutter_right: Float

// The whole picture.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${plotfigure.figure(640.0, 480.0, []).width}")
// ```
pub struct PlotFigure
    // How wide the figure is, in the units the backend interprets: user
    // units in an SVG, pixels before scaling in a raster.
    width: Float
    // How tall it is.
    height: Float
    // What is painted behind everything.  A fully transparent
    // background means no background operation is emitted at all, which
    // is what an SVG going into a page wants.
    background: Srgba8
    // A heading above the whole figure, above any axes titles.  Empty
    // draws none.
    title: Str
    // The axes, in draw order.
    axes: [PlotAxes]

// A figure of a given size with a white background and no title.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println("${plotfigure.figure(640.0, 480.0, []).height}")
// ```
pub fn figure(width: Float, height: Float, axes: [PlotAxes]) -> PlotFigure
    todo("plot-nv.plotfigure.figure")

// A figure holding exactly one axes, filling it.
//
// The call a notebook cell makes: one chart, one line, done.
//
// ```novo
// use plotfigure
// use plotseries
//
// fn main() [io]
//     let f = plotfigure.single(640.0, 480.0, [plotseries.line("y", [0.0], [0.0])])
//     println("${list.len(f.axes)}")
// ```
pub fn single(width: Float, height: Float, series: [PlotSeries]) -> PlotFigure
    todo("plot-nv.plotfigure.single")

// An axes filling its figure, with the default gutters.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     println("${plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), []).fh}")
// ```
pub fn axes(x: PlotAxis, y: PlotAxis, series: [PlotSeries]) -> PlotAxes
    todo("plot-nv.plotfigure.axes")

// A regular grid of axes, `rows` by `cols`, in reading order.
//
// The whole of the layout this package does.  Each cell gets an equal
// fraction with `spacing` of the figure left between them; a caller who
// wants unequal cells sets the fractions itself.
//
// ```novo
// use plotfigure
// use std.list
//
// fn main() [io]
//     println("${list.len(plotfigure.grid(2, 2, 0.05))}")
// ```
pub fn grid(rows: Int, cols: Int, spacing: Float) -> [PlotAxes]
    todo("plot-nv.plotfigure.grid")

// The same figure with a title.
//
// ```novo
// use plotfigure
//
// fn main() [io]
//     println(plotfigure.with_title(plotfigure.figure(10.0, 10.0, []), "sales").title)
// ```
pub fn with_title(f: PlotFigure, title: Str) -> PlotFigure
    todo("plot-nv.plotfigure.with_title")

// The same figure on a different background.
//
// ```novo
// use plotfigure
// use srgb
//
// fn main() [io]
//     let f = plotfigure.with_background(plotfigure.figure(10.0, 10.0, []), srgb.transparent())
//     println("${f.background.a}")
// ```
pub fn with_background(f: PlotFigure, color: Srgba8) -> PlotFigure
    todo("plot-nv.plotfigure.with_background")

// The same figure with one more axes.
//
// ```novo
// use plotfigure
// use plotaxis
//
// fn main() [io]
//     let ax = plotfigure.axes(plotaxis.linear("x"), plotaxis.linear("y"), [])
