// A one-dimensional ndarray as a list of values.
//
// The adapter, and it is one direction on purpose: this package reads
// arrays and never returns them.  An array of any other rank is
// FLATTENED in row-major order rather than refused, because that is what
// a notebook cell passing a column slice usually means and refusing it
// would make the common case a two-line conversion.
//
// ```novo
// use plotseries
// use std.list
//
// fn main() [io]
//     match ndfloat.zeros([3])
//         Ok(a)  => println("${list.len(plotseries.of_ndfloat(a))}")
//         Err(_) => println("no array")
// ```
pub fn of_ndfloat(a: NdFloat) -> [Float]
    todo("plot-nv.plotseries.of_ndfloat")

// A dataframe column as a list of values, with the nulls dropped.
//
// DROPPED, NOT ZEROED — a null is missing data and zero is a
// measurement.  What it costs is that the result may be shorter than
// the column, so a caller pairing two columns should use
// `of_column_pair`, which drops a row only when EITHER side is null and
// so keeps the two aligned.
//
// A column of a type that is not numeric answers an empty list.
//
// ```novo
// use plotseries
// use std.list
//
// fn main() [io]
//     let c = DfColumn { name: "n", cells: DfIntCells([1, 2]), present: [true, true] }
//     println("${list.len(plotseries.of_column(c))}")
// ```
pub fn of_column(c: DfColumn) -> [Float]
    todo("plot-nv.plotseries.of_column")

// Two columns as aligned value lists, dropping a row where either is
// null.
//
// The pairing rule written once.  Two separate `of_column` calls on
// columns with nulls in different places give two lists of different
// lengths and silently shift every point after the first gap — which is
// the bug this function exists to make unavailable.
//
// ```novo
// use plotseries
// use std.list
//
// fn main() [io]
//     let c = DfColumn { name: "n", cells: DfIntCells([1, 2]), present: [true, true] }
//     let (xs, ys) = plotseries.of_column_pair(c, c)
//     println("${list.len(xs)} ${list.len(ys)}")
// ```
pub fn of_column_pair(x: DfColumn, y: DfColumn) -> ([Float], [Float])
    todo("plot-nv.plotseries.of_column_pair")

// A line series per named column of a table, against one shared x
// column.
//
// The call a notebook makes most: a frame with a time column and four
// measurements, and one chart with four lines on it.  Each series takes
// its label from its column's name and its colour from `palette_color`
// at its index — the one place a cycle IS applied, because here the
// caller asked for many series at once and naming four colours by hand
// is the friction this function removes.
//
// ```novo
// use plotseries
// use std.list
//
// fn main() [io]
//     let t = DfTable { columns: [], rows: 0 }
//     println("${list.len(plotseries.of_table_columns(t, "t", []))}")
// ```
pub fn of_table_columns(t: DfTable, x_column: Str, y_columns: [Str]) -> [PlotSeries]
    todo("plot-nv.plotseries.of_table_columns")

// How many points a series holds, before any binning.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println("${plotseries.point_count(plotseries.line("y", [0.0], [0.0]))}")
// ```
pub fn point_count(s: PlotSeries) -> Int
    todo("plot-nv.plotseries.point_count")

// Whether a series' x and y lists are the same length.
//
// The one shape error a figure has — see `PlotLengthMismatch` — asked
// before rendering so the fault names the series.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println("${plotseries.is_consistent(plotseries.line("y", [0.0], [0.0]))}")
// ```
pub fn is_consistent(s: PlotSeries) -> Bool
    todo("plot-nv.plotseries.is_consistent")

// The lowest and highest x a series occupies.
//
// Not a tuple of a `@value` struct — two `Float`s, which a tuple may
// hold.  An empty series answers `(0.0, 0.0)`, and `point_count` is what
// distinguishes that from a series of one point at the origin.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     let (lo, hi) = plotseries.x_extent(plotseries.line("y", [0.0, 3.0], [0.0, 0.0]))
//     println("${lo} ${hi}")
// ```
pub fn x_extent(s: PlotSeries) -> (Float, Float)
    todo("plot-nv.plotseries.x_extent")

// The lowest and highest y a series occupies.
//
// For a bar series this is 0 to the tallest bar, because a bar starts at
// the axis — an extent of just the values would cut every bar off at its
// own base.  For a histogram it is 0 to the fullest bin, which means the
// binning has to run, which is why this takes the rule with it.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     let (lo, hi) = plotseries.y_extent(plotseries.line("y", [0.0], [5.0]))
//     println("${lo} ${hi}")
// ```
pub fn y_extent(s: PlotSeries) -> (Float, Float)
    todo("plot-nv.plotseries.y_extent")

// The bin edges a rule produces for a set of values.
//
// Public and separate from the rendering, because the edges are the
// thing to check: a histogram that looks wrong is almost always a
// histogram whose bins are wrong, and a caller can print these.
// `PlotBadBinning` when the rule produces none.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     match plotseries.bin_edges([1.0, 2.0, 3.0], PlotBinsCount(2))
//         Ok(e)  => println("${list.len(e)}")
//         Err(_) => println("refused")
// ```
pub fn bin_edges(values: [Float], rule: PlotBinRule) -> Result<[Float], PlotFault>
    todo("plot-nv.plotseries.bin_edges")

// How many values fall in each bin, given the edges.
//
// A value on an edge goes in the bin ABOVE it, and the top edge is
// inclusive so the largest value is counted — numpy's rule, and the one
// that makes the counts add up to the number of values.
//
// ```novo
// use plotseries
// use std.list
//
// fn main() [io]
//     println("${list.len(plotseries.bin_counts([1.0, 2.0], [0.0, 1.5, 3.0]))}")
// ```
pub fn bin_counts(values: [Float], edges: [Float]) -> [Int]
    todo("plot-nv.plotseries.bin_counts")

// The name a mark is known by.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.mark_name(PlotMarkDiamond))
// ```
pub fn mark_name(m: PlotMark) -> Str
    todo("plot-nv.plotseries.mark_name")

// The name a series kind is known by.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.kind_name(PlotScatterOf([0.0], [0.0])))
// ```
pub fn kind_name(k: PlotSeriesKind) -> Str
    todo("plot-nv.plotseries.kind_name")

// The nth colour of the default palette, wrapping.
//
// EIGHT COLOURS, chosen to stay distinguishable under the two common
// forms of colour blindness and to hold their contrast on both a white
// and a dark background — checked with color-nv's own contrast rules
// rather than picked by eye.  A caller who wants a different palette
// passes their own colours to `with_color`; this one exists so that the
// default chart is readable rather than so that nobody changes it.
//
// ```novo
// use plotseries
// use srgb
//
// fn main() [io]
//     println("${plotseries.palette_color(0).a}")
// ```
pub fn palette_color(n: Int) -> Srgba8
    todo("plot-nv.plotseries.palette_color")

// The default style for a series of this kind: colour, width, mark,
// alpha.
//
// What `line`, `scatter`, `bars` and `histogram` apply, exposed so a
// caller building a `PlotSeries` literal can start from it.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println("${plotseries.default_style(PlotLineOf([0.0], [0.0]), 0).width}")
// ```
pub fn default_style(kind: PlotSeriesKind, index: Int) -> PlotSeries
    todo("plot-nv.plotseries.default_style")
