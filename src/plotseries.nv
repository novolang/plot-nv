// plotseries.nv — the four series a notebook draws, and the adapters
// that get data into them.
//
// FOUR KINDS, AND THE MEASUREMENT BEHIND THAT NUMBER.  Line, scatter,
// bar and histogram are what a notebook corpus actually contains; the
// long tail after them — box, violin, heatmap, contour, error bars,
// stacked areas, pie — is each a different layout problem rather than a
// variation on these.  Adding one later is a variant here and a branch
// in `plotdraw`, which is a day; getting the first four wrong is the
// whole package.
//
// DATA ARRIVES AS `[Float]`, AND THE ADAPTERS ARE WHY.  A series holds
// plain lists, and `of_ndfloat`, `of_column` and `of_table_columns`
// convert.  The alternative — a `PlotData` enum with a variant per
// source — would put ndarray-nv and dataframe-nv inside every series
// value and make a caller with a bare `[Float]` construct one of their
// types to get a chart.  Converting at the edge costs one copy per
// series and keeps the renderer reading one thing.
//
// A NULL IS A GAP, NOT A ZERO.  `of_column` drops the positions a
// dataframe column marks absent, and a LINE series drawn from one is
// broken there rather than joined across it — because a line that
// bridges a gap asserts data that is not in the frame.  That is
// matplotlib's behaviour for a masked array and pandas's for a NaN, and
// it is the one place this package's answer is not the naive one.
//
// NO EFFECTS.

use srgb
use ndfloat

// The shape a marked point is drawn in.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.mark_name(PlotMarkCircle))
// ```
pub enum PlotMark
    // No mark.  What a line series uses.
    PlotMarkNone
    // A filled disc.  The scatter default.
    PlotMarkCircle
    // A filled square.
    PlotMarkSquare
    // A filled triangle, point up.
    PlotMarkTriangle
    // A filled diamond.
    PlotMarkDiamond
    // Two strokes, upright.
    PlotMarkPlus
    // Two strokes, diagonal.
    PlotMarkCross

// Which way a bar series runs.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println("${PlotBarsVertical == PlotBarsVertical}")
// ```
pub enum PlotOrientation
    // Bars rise from the x axis.  The default.
    PlotBarsVertical
    // Bars extend from the y axis, which is what a chart with long
    // category names wants — a horizontal label always fits.
    PlotBarsHorizontal

// How a histogram's bins are chosen.
//
// Every one of these is a named rule from the statistics literature and
// all four are in numpy's `histogram_bin_edges`, which is the reference.
// The choice matters more than it looks: the same data binned by Sturges
// and by Freedman-Diaconis can look unimodal or bimodal.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println("${PlotBinsSturges == PlotBinsSturges}")
// ```
pub enum PlotBinRule
    // Exactly this many bins, evenly spaced across the data's range.
    PlotBinsCount(n: Int)
    // Bins this wide, from the first multiple at or below the minimum.
    PlotBinsWidth(width: Float)
    // Sturges's rule: `ceil(log2(n)) + 1` bins.  Assumes the data is
    // roughly normal, and under-bins anything heavy-tailed — but it is
    // the default in most software and so it is the familiar picture.
    PlotBinsSturges
    // Freedman-Diaconis: bin width `2 * IQR / cbrt(n)`.  Uses the
    // interquartile range rather than the extent, so one outlier does
    // not flatten the whole histogram.  The better default for real
    // data, and the reason both are here.
    PlotBinsFreedmanDiaconis

// What one series draws.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.kind_name(PlotLineOf([0.0], [0.0])))
// ```
pub enum PlotSeriesKind
    // Points joined in the order given.  NOT sorted by x: a caller
    // plotting a trajectory, a hysteresis loop or a parametric curve
    // means the order they gave.
    PlotLineOf(xs: [Float], ys: [Float])
    // Points, unjoined.
    PlotScatterOf(xs: [Float], ys: [Float])
    // One bar per category, at x = 0, 1, 2 and so on — which is what
    // `plotaxis.categorical` places its ticks at, so bars and a line
    // share one coordinate system.
    PlotBarOf(values: [Float], orientation: PlotOrientation)
    // One series of raw values, counted into bins by a rule.  The
    // BINNING HAPPENS AT RENDER, not here, so a caller can change the
    // rule without rebuilding the series and so the bin edges are
    // computed once against the axis's final range.
    PlotHistogramOf(values: [Float], bins: PlotBinRule)

// One series: what it draws, and how.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.line("y", [0.0], [0.0]).label)
// ```
pub struct PlotSeries
    // What it draws.
    kind: PlotSeriesKind
    // What the legend calls it.  Empty keeps it out of the legend,
    // which is how a caller draws a reference line without naming it.
    label: Str
    // Its colour.  Set explicitly rather than cycled: a caller who
    // wants the cycle asks `palette_color` for index n, and one who
    // wants their own says so.  A cycle applied silently is how two
    // charts in the same notebook end up with the same colour meaning
    // two different things.
    color: Srgba8
    // How wide a line or a bar outline is.
    width: Float
    // The dash pattern for a line: on, off, on, off.  Empty is solid.
    dash: [Float]
    // The mark on each point.
    mark: PlotMark
    // How big a mark is, across.
    mark_size: Float
    // How opaque the whole series is, `0.0 ..= 1.0`, on top of the
    // colour's own coverage.  What a scatter with ten thousand
    // overlapping points needs.
    alpha: Float

// A line series with the default style.
//
// ```novo
// use plotseries
//
// fn main() [io]
//     println(plotseries.line("temperature", [0.0, 1.0], [20.0, 21.0]).label)
// ```
pub fn line(label: Str, xs: [Float], ys: [Float]) -> PlotSeries
    todo("plot-nv.plotseries.line")

